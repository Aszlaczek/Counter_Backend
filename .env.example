DATABASE_URL=sqlite:///./extra_hours.db
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-before-starting
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false
# Disable after creating the required administrator accounts.
ALLOW_REGISTRATION=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000","http://127.0.0.1:3000"]
APP_NAME="Extra Hours Management API"
APP_VERSION=1.0.0
